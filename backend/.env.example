PINGCE_ENV=dev
# Platform core datastores
PINGCE_DATABASE_URL=
PINGCE_READ_REPLICA_URL=
PINGCE_REDIS_URL=redis://localhost:6379/0
# Object storage: local | s3
PINGCE_STORAGE_BACKEND=local
PINGCE_LOCAL_STORAGE_ROOT=var/assets
PINGCE_OSS_ENDPOINT=
PINGCE_OSS_BUCKET=
PINGCE_OSS_ACCESS_KEY=
PINGCE_OSS_SECRET_KEY=
PINGCE_OSS_REGION=us-east-1
PINGCE_OSS_SECURE=true
PINGCE_OSS_PATH_STYLE=false
PINGCE_OSS_PRESIGN_TTL_SECONDS=900
PINGCE_OSS_PUBLIC_BUCKET=false
PINGCE_MCP_AUTH_MODE=api_key
PINGCE_MCP_API_KEY_PEPPER=change-me-pepper
PINGCE_MCP_CURSOR_SECRET=change-me-cursor
PINGCE_MCP_CONTRACTS_PATH=../specs/001-mcp-server/contracts/tools.yaml
PINGCE_MCP_MAX_RESULT_BYTES=65536
PINGCE_MCP_MAX_PAGE_SIZE=100
PINGCE_MCP_DB_DSN=
PINGCE_MCP_AUDIT_DSN=
PINGCE_MCP_REDIS_URL=
# Production: app.services.readonly:build_readonly_services
# Leave empty in development to use the deterministic in-memory services.
# The deploy compose file sets the production value explicitly.
PINGCE_MCP_SERVICES_FACTORY=
PINGCE_MCP_DNS_REBINDING_PROTECTION=true
PINGCE_MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]

# Provider secrets: provider_config.secret_ref points here, never the key itself.
# secret://env/OPENAI_API_KEY resolves OPENAI_API_KEY at call time.
OPENAI_API_KEY=

# OpenTelemetry / Grafana (docker compose -f deploy/compose.yaml -f deploy/compose.observability.yaml)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=pingce-platform
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# OAuth is reserved; leave empty for API key mode.
PINGCE_MCP_OAUTH_ISSUER=
PINGCE_MCP_OAUTH_AUDIENCE=
PINGCE_MCP_OAUTH_JWKS_URL=
PINGCE_MCP_OAUTH_RESOURCE_METADATA_URL=
