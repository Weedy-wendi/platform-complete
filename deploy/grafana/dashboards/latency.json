{
  "title": "Pingce - Latency",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"type": "timeseries", "title": "HTTP P95", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))"}]},
    {"type": "timeseries", "title": "MCP tool P95", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(mcp_tool_duration_seconds_bucket[5m])) by (le, tool))"}]},
    {"type": "timeseries", "title": "Model call P95", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(model_call_duration_seconds_bucket[5m])) by (le, provider))"}]},
    {"type": "timeseries", "title": "Read model P95", "targets": [{"expr": "histogram_quantile(0.95, sum(rate(read_model_query_duration_seconds_bucket[5m])) by (le))"}]}
  ]
}
