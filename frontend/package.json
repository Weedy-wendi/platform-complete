{
  "name": "pingce-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "openapi-typescript ../specs/017-rest-api/contracts/openapi.yaml -o src/types/api.ts",
    "test": "vitest run",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "element-plus": "^2.9.0",
    "marked": "^18.1.3",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
